# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: For OAuth providers
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord webhook for strategy reports
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Cron auth (Vercel cron sends this as a Bearer token; also usable as ?key= for manual runs)
CRON_SECRET=your_cron_secret

# Admin allowlist — users allowed to edit reference data (score limits, name/venue
# mappings, uploads, bulk renames). Comma-separated. Match by Supabase user id
# and/or email. The NEXT_PUBLIC_* copies are read on the client only to decide
# whether to show admin UI; the server enforces auth using the non-public ones.
ADMIN_USER_IDS=
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_USER_IDS=
NEXT_PUBLIC_ADMIN_EMAILS=
